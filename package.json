{
  "name": "atbolo",
  "private": true,
  "version": "0.1.0",
  "description": "A persistent-world, massively-multiplayer-ish reimagining of the classic Mac tank game Bolo",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "deploy": "pnpm --filter @bolo/client build && pnpm --filter @bolo/server run deploy",
    "test": "pnpm --filter '@bolo/shared' --filter '@bolo/server' --filter '@bolo/client' --parallel test",
    "test:run": "pnpm --filter '@bolo/shared' --filter '@bolo/server' --filter '@bolo/client' exec vitest run"
  },
  "packageManager": "pnpm@11.6.0",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  }
}
